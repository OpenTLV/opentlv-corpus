{
  "mutations": [
    {"name": "phase-unknown", "description": "The phase is 0.x or stable.", "mutations": [{"op": "replace", "path": "/phase", "value": "1.x"}], "violation": {"schema": ["/phase"]}},
    {"name": "seq-zero", "description": "Sequence numbers start at 1.", "mutations": [{"op": "replace", "path": "/events/0/seq", "value": 0}], "violation": {"schema": ["/events/0/seq"]}},
    {"name": "digest-uppercase", "description": "A digest is sha256: and 64 lowercase hexadecimal digits.", "mutations": [{"op": "replace", "path": "/events/0/digest", "value": "sha256:1A9FCE60BC0C456CB99B038D01B5AB7D11BBC54A7D7EDA0246FC561198F7DB59"}], "violation": {"schema": ["/events/0/digest"]}},
    {"name": "reason-of-other-event", "description": "A deprecation cannot give an invalidation reason.", "mutations": [{"op": "replace", "path": "/events/0/reason/code", "value": "expectation-wrong"}], "violation": {"schema": ["/events/0/reason/code"]}},
    {"name": "detail-missing", "description": "Every reason has a detail.", "mutations": [{"op": "remove", "path": "/events/0/reason/detail"}], "violation": {"schema": ["/events/0/reason"]}},
    {"name": "duplicate-without-replacement", "description": "A duplicate or superseded case names its replacement.", "mutations": [{"op": "remove", "path": "/events/0/replacement"}], "violation": {"schema": ["/events/0"]}},
    {"name": "deprecate-with-revised-digest", "description": "Only a revise event has a revised digest.", "mutations": [{"op": "add", "path": "/events/0/revised_digest", "value": "sha256:b4739538d50f8646aaa4af52e9f34543febba63189e821f9ea79f0afa2041449"}], "violation": {"schema": ["/events/0"]}},
    {"name": "reinstate-with-replacement", "description": "A reinstated case has no replacement.", "mutations": [{"op": "add", "path": "/events/-", "value": {"seq": 3, "case": "example.der.000009", "digest": "sha256:1a9fce60bc0c456cb99b038d01b5ab7d11bbc54a7d7eda0246fc561198f7db59", "event": "reinstate", "reason": {"code": "deprecation-withdrawn", "detail": "x"}, "replacement": "example.der.000001", "actor": "Marek Cingel", "review": {"status": "self-reviewed", "reviewers": ["Marek Cingel"], "date": "2026-11-06"}}}], "violation": {"schema": ["/events/2"]}},
    {"name": "revise-without-revised-digest", "description": "A revise event records the digest after the revision.", "mutations": [{"op": "add", "path": "/events/-", "value": {"seq": 3, "case": "example.der.000001", "digest": "sha256:1111111111111111111111111111111111111111111111111111111111111111", "event": "revise", "reason": {"code": "expectation-wrong", "detail": "x"}, "actor": "Marek Cingel", "review": {"status": "self-reviewed", "reviewers": ["Marek Cingel"], "date": "2026-11-06"}}}], "violation": {"schema": ["/events/2"]}},
    {"name": "expectation-in-event", "description": "Events reject unknown members.", "mutations": [{"op": "add", "path": "/events/0/expected", "value": {"outcome": "accept"}}], "violation": {"schema": ["/events/0"]}},
    {"name": "event-sequence", "description": "seq equals the position in the log.", "mutations": [{"op": "replace", "path": "/events/1/seq", "value": 3}], "violation": {"semantic": ["event-sequence"]}},
    {"name": "event-case-unknown", "description": "Events apply to cases of their own set.", "mutations": [{"op": "replace", "path": "/events/1/case", "value": "example.der.000010"}], "violation": {"semantic": ["event-case-unknown"]}},
    {"name": "event-digest-mismatch", "description": "The digest names the definition the event applies to.", "mutations": [{"op": "replace", "path": "/events/1/digest", "value": "sha256:1953e4f439abd653231c2d2108343683f542dcff34e2d25cbbfc15755a1acbcf"}], "violation": {"semantic": ["event-digest-mismatch"]}},
    {"name": "invalid-is-terminal", "description": "An invalidated case is never reinstated.", "mutations": [{"op": "add", "path": "/events/-", "value": {"seq": 3, "case": "example.der.000007", "digest": "sha256:ebe77355bbe8461b4383d66fb4a842495fd56a747bd0fa143ce72dc6dc0f3e9d", "event": "reinstate", "reason": {"code": "deprecation-withdrawn", "detail": "x"}, "actor": "Marek Cingel", "review": {"status": "self-reviewed", "reviewers": ["Marek Cingel"], "date": "2026-11-06"}}}], "violation": {"semantic": ["transition-forbidden"]}},
    {"name": "deprecate-twice", "description": "A deprecated case cannot be deprecated again.", "mutations": [{"op": "add", "path": "/events/-", "value": {"seq": 3, "case": "example.der.000009", "digest": "sha256:1a9fce60bc0c456cb99b038d01b5ab7d11bbc54a7d7eda0246fc561198f7db59", "event": "deprecate", "reason": {"code": "out-of-scope", "detail": "x"}, "actor": "Marek Cingel", "review": {"status": "self-reviewed", "reviewers": ["Marek Cingel"], "date": "2026-11-06"}}}], "violation": {"semantic": ["transition-forbidden"]}},
    {"name": "replacement-unknown", "description": "The replacement exists in the same set.", "mutations": [{"op": "replace", "path": "/events/0/replacement", "value": "example.der.000010"}], "violation": {"semantic": ["replacement-unknown"]}},
    {"name": "replacement-self", "description": "A case does not replace itself.", "mutations": [{"op": "replace", "path": "/events/0/replacement", "value": "example.der.000009"}], "violation": {"semantic": ["replacement-cycle"]}},
    {"name": "replacement-cycle", "description": "example.der.000009 is already replaced by example.der.000001.", "mutations": [{"op": "add", "path": "/events/-", "value": {"seq": 3, "case": "example.der.000001", "digest": "sha256:b4739538d50f8646aaa4af52e9f34543febba63189e821f9ea79f0afa2041449", "event": "deprecate", "reason": {"code": "superseded", "detail": "x"}, "replacement": "example.der.000009", "actor": "Marek Cingel", "review": {"status": "self-reviewed", "reviewers": ["Marek Cingel"], "date": "2026-11-06"}}}], "violation": {"semantic": ["replacement-cycle"]}},
    {"name": "replacement-deprecated", "description": "The replacement is active when the event is recorded.", "mutations": [{"op": "add", "path": "/events/-", "value": {"seq": 3, "case": "example.der.000002", "digest": "sha256:1953e4f439abd653231c2d2108343683f542dcff34e2d25cbbfc15755a1acbcf", "event": "deprecate", "reason": {"code": "superseded", "detail": "x"}, "replacement": "example.der.000009", "actor": "Marek Cingel", "review": {"status": "self-reviewed", "reviewers": ["Marek Cingel"], "date": "2026-11-06"}}}], "violation": {"semantic": ["replacement-inactive"]}},
    {"name": "replacement-invalid", "description": "An invalidated case is never a replacement.", "mutations": [{"op": "add", "path": "/events/-", "value": {"seq": 3, "case": "example.der.000002", "digest": "sha256:1953e4f439abd653231c2d2108343683f542dcff34e2d25cbbfc15755a1acbcf", "event": "invalidate", "reason": {"code": "definition-wrong", "detail": "x"}, "replacement": "example.der.000007", "actor": "Marek Cingel", "review": {"status": "self-reviewed", "reviewers": ["Marek Cingel"], "date": "2026-11-06"}}}], "violation": {"semantic": ["replacement-inactive"]}},
    {"name": "revision-after-stable", "description": "After the first stable release only representation revisions are allowed.", "mutations": [{"op": "replace", "path": "/phase", "value": "stable"}, {"op": "add", "path": "/events/-", "value": {"seq": 3, "case": "example.der.000001", "digest": "sha256:1111111111111111111111111111111111111111111111111111111111111111", "event": "revise", "reason": {"code": "expectation-wrong", "detail": "x"}, "revised_digest": "sha256:b4739538d50f8646aaa4af52e9f34543febba63189e821f9ea79f0afa2041449", "actor": "Marek Cingel", "review": {"status": "self-reviewed", "reviewers": ["Marek Cingel"], "date": "2026-11-06"}}}], "violation": {"semantic": ["revision-after-stable"]}},
    {"name": "revision-unchanged", "description": "A revision changes the digest.", "mutations": [{"op": "add", "path": "/events/-", "value": {"seq": 3, "case": "example.der.000001", "digest": "sha256:b4739538d50f8646aaa4af52e9f34543febba63189e821f9ea79f0afa2041449", "event": "revise", "reason": {"code": "definition-wrong", "detail": "x"}, "revised_digest": "sha256:b4739538d50f8646aaa4af52e9f34543febba63189e821f9ea79f0afa2041449", "actor": "Marek Cingel", "review": {"status": "self-reviewed", "reviewers": ["Marek Cingel"], "date": "2026-11-06"}}}], "violation": {"semantic": ["revision-unchanged"]}},
    {"name": "review-status-mismatch", "description": "A self-review is by the actor only.", "mutations": [{"op": "replace", "path": "/events/0/review/reviewers", "value": ["Another Reviewer"]}], "violation": {"semantic": ["review-status-mismatch"]}},
    {"name": "review-not-independent", "description": "A peer review includes a reviewer other than the actor.", "mutations": [{"op": "replace", "path": "/events/0/review/status", "value": "peer-reviewed"}], "violation": {"semantic": ["review-not-independent"]}}
  ]
}
