{
  "schema": "urn:opentlv:corpus:schema:case:1",
  "id": "example.der.000001",
  "normative": {
    "standard": {
      "ref": "itu-t-x690-2021-02",
      "rules": "der"
    },
    "input": {
      "octets": "0101ff"
    },
    "assertions": [
      {
        "key": "decode",
        "request": {
          "operation": "decode",
          "strictness": "strict",
          "view": "tree"
        },
        "clauses": [
          "8.1.2.3",
          "8.1.2.5",
          "8.1.3.4",
          "8.2.1",
          "11.1"
        ],
        "expect": {
          "result": {
            "outcome": "accept",
            "tree": {
              "class": "universal",
              "constructed": false,
              "number": "1",
              "contents": "ff"
            }
          }
        }
      },
      {
        "key": "round-trip",
        "request": {
          "operation": "round-trip",
          "strictness": "strict",
          "view": "tree"
        },
        "clauses": [
          "10.1",
          "11.1"
        ],
        "expect": {
          "result": {
            "outcome": "accept",
            "preserves": "octets"
          }
        }
      }
    ]
  },
  "informative": {
    "title": "DER BOOLEAN TRUE decodes to one primitive node",
    "tags": [
      "primitive",
      "boolean"
    ],
    "oracle": {
      "source": "specification",
      "rationale": "01 is the universal class, primitive, tag number 1 (8.1.2.3, 8.1.2.5); 01 is a one-octet short-form length (8.1.3.4); FF is the single contents octet a CER or DER TRUE requires (8.2.1, 11.1). DER has exactly one encoding of each value, so re-encoding the decoded tree reproduces the input (10.1, 11.1).",
      "review": {
        "status": "self-reviewed",
        "reviewers": [
          "Marek Cingel"
        ],
        "date": "2026-11-06"
      }
    },
    "provenance": {
      "origin": "authored",
      "authors": [
        "Marek Cingel"
      ],
      "license": "MIT"
    }
  }
}
