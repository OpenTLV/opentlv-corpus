  "informative": {
    "title": "DER INTEGER 128 needs a leading zero octet",
    "tags": [
      "primitive",
      "integer",
      "boundary"
    ],
    "oracle": {
      "source": "specification",
      "rationale": "In two's complement 128 is 80 only with a leading 00 octet, and 00 80 is minimal because its first nine bits are not all zero (8.3.2, 8.3.3); DER requires the one-octet short-form length for the two contents octets (10.1).",
