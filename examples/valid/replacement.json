  "id": "example.der.000008",
  "normative": {
    "standard": {
      "ref": "itu-t-x690-2021-02",
      "rules": "der"
    },
    "input": {
      "octets": "010101"
    },
    "assertions": [
      {
        "key": "decode",
        "request": {
          "operation": "decode",
          "strictness": "strict",
          "view": "tree"
        },
        "clauses": [
          "8.2.2",
          "11.1"
        ],
        "expect": {
          "result": {
            "outcome": "reject",
            "reason": "contents.non-canonical"
          }
        }
      }
    ]
  },
  "informative": {
    "title": "DER rejects a BOOLEAN TRUE whose contents octet is not FF",
    "description": "Replaces the invalidated example.der.000007 in the example lifecycle log.",
    "tags": [
      "primitive",
      "boolean",
      "non-canonical",
      "malformed"
    ],
    "related": [
      "example.der.000007"
    ],
    "oracle": {
      "source": "specification",
      "rationale": "BER accepts any non-zero contents octet as TRUE (8.2.2), but CER and DER require all eight bits set to one (11.1), so a strict DER decoder rejects the contents octet 01.",
