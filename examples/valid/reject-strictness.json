{
  "schema": "urn:opentlv:corpus:schema:case:1",
  "id": "example.der.000004",
  "normative": {
    "standard": {
      "ref": "itu-t-x690-2021-02",
      "rules": "der"
    },
    "input": {
      "octets": "048101aa"
    },
    "assertions": [
      {
        "key": "strict",
        "request": {
          "operation": "decode",
          "strictness": "strict",
          "view": "tree"
        },
        "clauses": [
          "10.1"
        ],
        "expect": {
          "result": {
            "outcome": "reject",
            "reason": "length.non-minimal"
          }
        }
      },
      {
        "key": "lenient",
        "request": {
          "operation": "decode",
          "strictness": "lenient",
          "view": "tree"
        },
        "clauses": [
          "8.1.3.5",
          "10.1"
        ],
        "expect": {
          "one_of": [
            {
              "outcome": "reject",
              "reason": "length.non-minimal"
            },
            {
              "outcome": "accept",
              "tree": {
                "class": "universal",
                "constructed": false,
                "number": "4",
                "contents": "aa"
              }
            }
          ],
          "basis": "implementation-defined"
        }
      }
    ]
  },
  "informative": {
    "title": "DER rejects a long-form length for one contents octet",
    "tags": [
      "length",
      "non-minimal",
      "malformed"
    ],
    "related": [
      "example.der.000005"
    ],
    "oracle": {
      "source": "specification",
      "rationale": "81 01 is a valid BER long-form length of one (8.1.3.5), but DER requires the minimum number of length octets (10.1), so a strict DER decoder rejects it. A lenient decoder may still enforce the rule or decode the BER framing to OCTET STRING AA; X.690 does not define lenient decoders.",
      "review": {
        "status": "self-reviewed",
        "reviewers": [
          "Marek Cingel"
        ],
        "date": "2026-11-06"
      }
    },
    "provenance": {
      "origin": "authored",
      "authors": [
        "Marek Cingel"
      ],
      "license": "MIT"
    }
  }
}
