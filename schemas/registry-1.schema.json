{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opentlv:corpus:schema:registry:1",
  "title": "OpenTLV Corpus registry, schema version 1",
  "description": "Registered standard editions, ID namespaces with their serial allocation, expected-reason taxonomy and capability vocabulary. See docs/identity.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "standards", "namespaces", "reasons", "capabilities"],
  "properties": {
    "schema": {"const": "urn:opentlv:corpus:schema:registry:1"},
    "standards": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/standard"}},
    "namespaces": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/namespace"}},
    "reasons": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/reason"}},
    "capabilities": {"type": "array", "items": {"$ref": "#/$defs/capability"}}
  },
  "$defs": {
    "key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "dottedKey": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*(\\.[a-z][a-z0-9]*(-[a-z0-9]+)*)*$",
      "maxLength": 128
    },
    "text": {"type": "string", "minLength": 1},
    "standard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "document", "edition", "title", "url", "rules"],
      "properties": {
        "id": {"$ref": "#/$defs/key"},
        "document": {"$ref": "#/$defs/text"},
        "edition": {"$ref": "#/$defs/text"},
        "title": {"$ref": "#/$defs/text"},
        "url": {"type": "string", "pattern": "^https://"},
        "rules": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/key"}}
      }
    },
    "namespace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "purpose", "title", "rules", "standards", "allocated"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9]{0,15}\\.[a-z][a-z0-9]{0,15}$"},
        "purpose": {
          "description": "conformance namespaces hold releasable cases; example namespaces hold documentation and test examples and never appear in a release.",
          "enum": ["conformance", "example"]
        },
        "title": {"$ref": "#/$defs/text"},
        "rules": {"$ref": "#/$defs/key"},
        "standards": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/key"}},
        "allocated": {
          "description": "Highest serial ever allocated in the namespace. It never decreases, so a serial is never reused.",
          "type": "integer",
          "minimum": 0,
          "maximum": 999999
        },
        "closed": {"const": true, "description": "No further serials may be allocated."}
      }
    },
    "reason": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "description"],
      "properties": {
        "code": {"$ref": "#/$defs/dottedKey"},
        "description": {"$ref": "#/$defs/text"},
        "deprecated": {"const": true}
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description"],
      "properties": {
        "id": {"$ref": "#/$defs/dottedKey"},
        "description": {"$ref": "#/$defs/text"}
      }
    }
  }
}
